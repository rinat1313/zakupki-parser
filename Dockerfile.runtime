FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*
COPY bin/parser-service /usr/local/bin/parser-service
ENV HTTP_ADDR=:8091
EXPOSE 8091
HEALTHCHECK --interval=10s --timeout=5s --retries=10 CMD curl -fsS http://127.0.0.1:8091/health || exit 1
CMD ["parser-service"]
